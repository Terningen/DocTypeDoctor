<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>DocTypeDoctor</Product>
    <PackageId>DocTypeDoctor</PackageId>
    <Title>Doc Type Doctor </Title>
    <Description>DocTypeDoctor is an Umbraco package that provides analysis tools for document types. It helps identify similar document types, unused properties, composition chains, and property naming issues to improve content model quality and maintainability.</Description>
    <PackageTags>umbraco;umbraco-marketplace</PackageTags>
    <Authors>Terningen</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Terningen</Copyright>
    <PackageProjectUrl>https://github.com/Terningen/DocTypeDoctor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Terningen/DocTypeDoctor</RepositoryUrl>
    <PackageReadmeFile>README-nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\..\README-nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>